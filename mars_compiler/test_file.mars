import imu_driver;

imu_driver.init_imu();

int i = 0;
while (i < 5) {
    float[] accel_g = imu_driver.read_acceleration_g();
    float[] accel_ms2 = imu_driver.read_acceleration_ms2();

    print("sample", i);
    print("accel_g", accel_g[0], accel_g[1], accel_g[2]);
    print("accel_ms2", accel_ms2[0], accel_ms2[1], accel_ms2[2]);

    wait(0.5);
    i += 1;
}

imu_driver.cleanup();
