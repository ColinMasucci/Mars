import keyboardDemoTwist;
import imuVisualizer;
import keyboard_input;

print("DeepRacer KeyboardDemoTwist + IMU Visualizer demo");

KeyboardDemoTwist demo = KeyboardDemoTwist(Deimos);
IMUVisualizer visualizer = IMUVisualizer(Deimos);

visualizer.setTitle("DeepRacer Twist + IMU Visualizer");
visualizer.setDtHint(0.1::s);
visualizer.setVectorGain(120.0);
visualizer.configure();

print("KeyboardDemoTwist");
print("controlMode", demo.controlMode);
demo.printInstructions();
demo.printSpeed();
demo.stopMotion();

while (true) {
    string key = keyboard_input.read_command(0.1::s);
    if (key == "quit") {
        break;
    }

    demo.applyKey(key);
    visualizer.tick();
}

demo.stopMotion();
visualizer.close();
keyboard_input.cleanup();
