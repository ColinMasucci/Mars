import driveIMU;

print("Phobos DriveIMU motion test");

Phobos.chassis.init();
Phobos.imu.init();

DriveIMU driver = DriveIMU(Phobos);

print("Hold robot still for calibration...");
wait(1.0::s);
driver.calibrate();

print("Calibration complete.");
print("Driving straight...");
driver.driveStraight(0.35, 2.0::s);

wait(1.0::s);
print("Turning +90 deg (CCW expected)...");
driver.turn(0.0, 90.0::deg);

wait(1.0::s);
print("Turning -90 deg (CW expected)...");
driver.turn(0.0, -90.0::deg);

wait(1.0::s);
print("Driving straight again...");
driver.driveStraight(0.35, 2.0::s);

Phobos.chassis.stop();
print("Motion test complete.");
