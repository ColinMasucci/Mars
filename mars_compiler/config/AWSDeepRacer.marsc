### AWS DeepRacer ###

component Deimos extends Robot {

    subcomponents{
        AWSDeepRacerChassis chassis;
        AWSDeepRacerIMU imu;
    }
    parameters{}
    functions{}
}

component AWSDeepRacerChassis extends AckermannChassis {
    subcomponents{
        @Override Motor driveMotor;
        @Override Motor steerMotor;
    }
    parameters{
        string controlMode = "twist";

        #float vx = subscribe("/imu_pkg/data_raw", "sensor_msgs/msg/Imu/orientation/x");
    }
    functions{
        void drive(float::m/s vx, float::m/s vy, float::rad/s vw){
            publish("/cmd_vel", "geometry_msgs/msg/Twist", {
            "linear": {"x": -vx, "y": 0.0, "z": 0.0},
            "angular": {"x": 0.0, "y": 0.0, "z": vw} });
        }

        void stop(){
            publish("/cmd_vel", "geometry_msgs/msg/Twist", {
            "linear": {"x": 0.0, "y": 0.0, "z": 0.0},
            "angular": {"x": 0.0, "y": 0.0, "z": 0.0} });
        }
    }
}


/*

/cmd_vel (geometry_msgs/msg/Twist)
  linear:
    x: float
    y: float
    z: float
  angular: geometry_msgs/Vector3

*/

component AWSDeepRacerIMU extends IMU {
       subcomponents{}
    parameters{
        bool accelerometer = true;
        bool gyro = true;
        bool magnetometer = false;
        bool orientation = false;
        int axisCount = 3;
        int bus=1;
        int address=1;

        int regDeviceId = 117; # 0x75
        int regPowerMgmt1 = 107; # 0x6B
        int regSampleRateDiv = 25; # 0x19
        int regConfig = 26; # 0x1A
        int regGyroConfig = 27; # 0x1B
        int regAccelConfig = 28; # 0x1C
        int regAccelXoutH = 59; # 0x3B
        int regGyroXoutH = 67; # 0x43

        int expectedDeviceId = 104; # 0x68
        int clockSourceBits = 1; # PLL with X gyro reference

        int accelRangeG = 2;
        int gyroRangeDps = 250;
        int dlpfConfig = 3;
        int sampleRateDiv = 9;
        float rateHz = 100.0;
    }
    functions{
        @Override void init() ;
        @Override float::m/s^2[] getAcceleration() ;
        @Override float::rad/s[] getAngularVelocity() ;
        @Override float[] getMagneticField();
        @Override float[] getOrientation();
    }
}