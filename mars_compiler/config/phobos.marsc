import motor_driver;
import imu_driver;
import math;

component Phobos extends Robot {
    subcomponents{
        # Swap Chassis
        PhobosChassisA chassis;
        #PhobosChassisB chassis;

        ADXL345 imu(bus = 1, address = 83); # 83 = 0x53
    }
    parameters{}
    functions{}
}

component PhobosChassisA extends SkidChassis {
    subcomponents {
        N20 frontLeftMotor(direction = 1, forward=22, backward=23, sleep=12);
        N20 rearLeftMotor(direction = 1, forward=24, backward=25, sleep=13);
        N20 frontRightMotor(direction = 1, forward=17, backward=27, sleep=12);
        N20 rearRightMotor(direction = 1, forward=26, backward=16, sleep=13);
    }
    parameters {
        float maxLinearSpeed = 1;
        string controlMode = "tank";
    }
    functions {
        void init(){
            frontLeftMotor.init();
            rearLeftMotor.init();
            frontRightMotor.init();
            rearRightMotor.init();
        }
        void drive(float leftSpeed, float rightSpeed){
            leftSpeed = math.max(-maxSpeed, math.min(leftSpeed, maxSpeed));
            rightSpeed = math.max(-maxSpeed, math.min(rightSpeed, maxSpeed));
            frontLeftMotor.spin(leftSpeed);
            rearLeftMotor.spin(leftSpeed);
            frontRightMotor.spin(rightSpeed);
            rearRightMotor.spin(rightSpeed);
        }
        void stop(){
            frontLeftMotor.stop();
            rearLeftMotor.stop();
            frontRightMotor.stop();
            rearRightMotor.stop();
        }
    }
}

component PhobosChassisA extends SkidChassis {
    subcomponents {
        N20 leftMotor(direction = 1, forward=22, backward=23, sleep=12);
        N20 rightMotor(direction = 1, forward=26, backward=16, sleep=13);
    }
    parameters {
        float maxSpeed = 1;
    }
    functions {
        void init(){

        }
        void drive(float leftSpeed, float rightSpeed){

        }
        void stop(){

        }
    }
}

component N20 extends BrushedMotor {
    subcomponents{
    }
    parameters{
        int direction; # 1 or -1

        # ports #
        int forward;
        int backward;
        int sleep;
    }
    functions{
        void init() {
            motor_driver.init_motor(forward, backward, sleep);
        }
        void spin(float speed) {
            # -1 to 1 for speed
            motor_driver.drive_motor(forward, backward, sleep, speed);
        }
        void stop() {
            motor_driver.stop();
        }
    }
}

component ADXL345 extends IMU {
    subcomponents{}
    parameters{
        bool accelerometer = true;
        bool gyro = false;
        bool magnetometer = false;
        bool orientation = false;
        int axisCount = 3;
        int bus;
        int address;

        int regDeviceId = 0; # 0x00
        int regBandwidthRate = 44; # 0x2C
        int regPowerControl = 45; # 0x2D
        int regDataFormat = 49; # 0x31
        int regDataX0 = 50; # 0x32

        int expectedDeviceId = 229; # 0xE5
        int measureBit = 8; # 0x08
        int fullResolutionBit = 8; # 0x08

        int rangeG = 2;
        float rateHz = 100.0;
        float gramsPerLsb = 0.00390625;
    }
    functions{
        void init() {
            imu_driver.init_imu(bus, address, regDeviceId, regBandwidthRate, regPowerControl, regDataFormat, regDataX0,
                expectedDeviceId, measureBit, fullResolutionBit, rangeG, rateHz, gramsPerLsb, math.g);
        }
        float::m/s^2[] getAcceleration() {
            return imu_driver.read_acceleration_ms2(bus, address);
        }
        @Override float::rad/s[] getAngularVelocity();
        @Override float[] getMagneticField();
        @Override float[] getOrientation();
    }
}

component IMU {
    subcomponents{}
    parameters{
        bool accelerometer;
        bool gyro;
        bool magnetometer;
        bool orientation;
        int axisCount;
        int bus;
        int address;
        float rateHz;
    }
    functions{
        void init();
        float::m/s^2[] getAcceleration();
        float::rad/s[] getAngularVelocity();
        float[] getMagneticField();
        float[] getOrientation();
    }
}
