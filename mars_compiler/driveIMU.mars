import math;
import complementaryFilter;

## Drive with IMU ##
/* 
    Help support smoother driving for wheeled robots without encoders.
    * driveStraight: correct angular drift by matching starting heading, P control
    * turn: turn for a given angle (deg), P control
*/

class DriveIMU {

    requirements {
        WheeledChassis;
        IMU(parameters=[accelerometer, gyro]);
    }

    WheeledChassis chassis;
    IMU imu;
    ComplementaryFilter headingFilter;
    float headingGain = 2.0;
    float turnGain = 2.5;
    float::deg turnTolerance = 2.0::deg;
    float::s controlPeriod = 0.02::s;
    float::s settleTime = 0.10::s;
    float::s biasCalibrationTime = 0.30::s;

    DriveIMU(Robot robot){
        chassis = robot.match(WheeledChassis);
        imu = robot.match(IMU);
        headingFilter = ComplementaryFilter(robot);
    }

    float normalizeAngle(float angle) {
        float twoPi = math.PI * 2;
        while (angle > math.PI) {
            angle = angle - twoPi;
        }
        while (angle <= -math.PI) {
            angle = angle + twoPi;
        }
        return angle;
    }

    float currentHeading() {
        float[] pose = headingFilter.getPose();
        return pose[2];
    }

    void prepareManeuver() {
        chassis.drive(0.0, 0.0, 0.0);
        wait(settleTime);
        headingFilter.resetFilter(0.0::rad);
        headingFilter.calibrateStationary(biasCalibrationTime, controlPeriod);
        headingFilter.resetHeading(0.0::rad);
    }

    void driveStraight(float speed, float::s time){
        float::s elapsed = 0.0::s;

        prepareManeuver();

        while (elapsed < time) {
            if (elapsed + controlPeriod > time) {
                headingFilter.updateFromImu(time - elapsed);
                chassis.drive(speed, 0.0, headingGain * -currentHeading());
                wait(time - elapsed);
                elapsed = time;
            } else {
                headingFilter.updateFromImu(controlPeriod);
                chassis.drive(speed, 0.0, headingGain * -currentHeading());
                wait(controlPeriod);
                elapsed = elapsed + controlPeriod;
            }
        }

        chassis.drive(0.0, 0.0, 0.0);
    }

    void turn(float speed, float::deg angle){
        float::rad targetAngle = angle;

        prepareManeuver();

        while (math.abs(targetAngle - currentHeading()) > turnTolerance) {
            chassis.drive(0.0, 0.0, turnGain * normalizeAngle(targetAngle - currentHeading()));
            wait(controlPeriod);
            headingFilter.updateFromImu(controlPeriod);
        }

        chassis.drive(0.0, 0.0, 0.0);
    }

}
