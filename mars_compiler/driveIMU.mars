import math;
import complementaryFilter;

## Drive with IMU ##
/* 
    Help support smoother driving for wheeled robots without encoders.
    * driveStraight: correct angular drift by matching starting heading, P control
    * turn: turn for a given angle (deg), P control
*/

class DriveIMU {

    requirements {
        WheeledChassis(parameters=[controlMode=="tank"]);
        IMU(parameters=[accelerometer, gyro]);
    }

    string controlMode = "tank";
    WheeledChassis chassis;
    IMU imu;
    ComplementaryFilter headingFilter;
    float headingGain = 2.0;
    float::rad turnTolerance = 2.0::deg;
    float::s controlPeriod = 0.02::s;
    float::s settleTime = 0.10::s;
    float::s biasCalibrationTime = 0.30::s;
    float maxTurnCommand = 0.8;
    bool calibrated = false;

    DriveIMU(Robot robot){
        chassis = robot.match(WheeledChassis);
        imu = robot.match(IMU);
        headingFilter = ComplementaryFilter(robot);
    }

    float::rad normalizeAngle(float::rad angle) {
        float twoPi = math.PI * 2;
        while (angle > math.PI) {
            angle = angle - twoPi;
        }
        while (angle <= -math.PI) {
            angle = angle + twoPi;
        }
        return angle;
    }

    float::rad currentHeading() {
        float[] pose = headingFilter.getPose();
        return pose[2];
    }

    float clamp(float value, float minValue, float maxValue) {
        if (value < minValue) {
            return minValue;
        }
        if (value > maxValue) {
            return maxValue;
        }
        return value;
    }

    void tankDrive(float linear, float turn) {
        float limitedTurn = clamp(turn, -maxTurnCommand, maxTurnCommand);
        float left = linear - limitedTurn;
        float right = linear + limitedTurn;
        chassis.drive(left, right);
    }

    void calibrate() {
        chassis.stop();
        wait(settleTime);
        headingFilter.resetFilter(0.0::rad);
        headingFilter.calibrateStationary(biasCalibrationTime, controlPeriod);
        headingFilter.resetHeading(0.0::rad);
        calibrated = true;
    }

    void requireCalibration() {
        if (!calibrated) {
            calibrate();
        }
    }

    void prepareManeuver() {
        requireCalibration();
        chassis.stop();
        wait(settleTime);
    }

    void driveStraight(float speed, float::s time){
        float::s elapsed = 0.0::s;

        prepareManeuver();

        while (elapsed < time) {
            if (elapsed + controlPeriod > time) {
                headingFilter.updateFromImu(time - elapsed);
                tankDrive(speed, headingGain * -currentHeading());
                wait(time - elapsed);
                elapsed = time;
            } else {
                headingFilter.updateFromImu(controlPeriod);
                tankDrive(speed, headingGain * -currentHeading());
                wait(controlPeriod);
                elapsed = elapsed + controlPeriod;
            }
        }

        chassis.stop();
    }

    void abs_turn(float speed, float::deg angle){
        float::rad targetAngle = normalizeAngle(angle);   # absolute target
        float::rad current = currentHeading();
        float::rad headingError = normalizeAngle(targetAngle - current);

        float turnLimit = math.abs(speed);

        float turnDirection = math.sign(angle);
        if (turnDirection == 0.0) {
            turnDirection = 1.0; # default direction if angle == 0
        }

        float turnCommand = turnDirection * turnLimit;

        prepareManeuver();

        while (math.abs(headingError) > turnTolerance) {
            print("heading:", current, "target:", targetAngle, "error:", headingError, "cmd:", turnCommand);

            tankDrive(0.0, turnCommand);
            wait(controlPeriod);

            headingFilter.updateFromImu(controlPeriod);
            current = currentHeading();

            if (turnDirection > 0) {
                headingError = normalizeAnglePositive(targetAngle - current);
            } else {
                headingError = -normalizeAnglePositive(current - targetAngle);
            }

            if (math.sign(headingError) != turnDirection) {
                break;
            }
        }

        chassis.stop();
    }



 
    void turn(float speed, float::deg angle){
        float::rad requestedTurn = 0.0::rad;
        float::rad requestedMagnitude = 0.0::rad;
        float::rad accumulatedTurn = 0.0::rad;
        float::rad previousHeading = 0.0::rad;
        float::rad current = 0.0::rad;
        float::rad delta = 0.0::rad;
        float::rad progress = 0.0::rad;
        float::rad remaining = 0.0::rad;
        float turnSign = 0.0;
        float turnCommand = 0.0;
        float fastMag = 0.0;
        float slowMag = 0.0;
        float cmdMag = 0.0;
        float::rad slowBand = 15.0::deg;

        prepareManeuver();
        requestedTurn = angle;
        turnSign = math.sign(requestedTurn);
        requestedMagnitude = math.abs(requestedTurn);
        fastMag = math.abs(speed);
        slowMag = math.max(0.20, fastMag * 0.5);

        if (requestedMagnitude <= turnTolerance || turnSign == 0.0) {
            chassis.stop();
            return;
        }

        previousHeading = currentHeading();

        while (accumulatedTurn < requestedMagnitude) {
            remaining = requestedMagnitude - accumulatedTurn;
            if (remaining <= slowBand) {
                cmdMag = slowMag;
            } else {
                cmdMag = fastMag;
            }
            turnCommand = turnSign * cmdMag;
            tankDrive(0.0, turnCommand);
            wait(controlPeriod);
            headingFilter.updateFromImu(controlPeriod);
            current = currentHeading();
            delta = normalizeAngle(current - previousHeading);
            progress = turnSign * delta;
            if (progress > 0.0::rad) {
                accumulatedTurn = accumulatedTurn + progress;
            }
            previousHeading = current;
        }

        chassis.stop();
    }

}
